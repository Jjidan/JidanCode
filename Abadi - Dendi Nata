<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Abadi - Dendi Nata</title>
    <style>
        
        body {
            background-color: #000;
            margin: 0;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            font-family: 'Arial Black', 'Impact', sans-serif;
        }

        
        .matrix-container {
            text-align: center;
            position: relative;
        }

        
        .dot-matrix-text {
            color: #fff; 
            font-size: 9rem; 
            font-weight: 900;
            letter-spacing: 4px;
            line-height: 1.2;
            text-transform: uppercase;
            position: relative;
            margin: 0;
            white-space: pre-line;
            
            
            text-shadow: 0 0 10px rgba(255, 255, 255, 0.8), 
                         0 0 20px rgba(255, 255, 255, 0.5);
        }

        
        .dot-matrix-text::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            
            
            background-image: 
                linear-gradient(90deg, #000 4px, transparent 4px),
                linear-gradient(0deg, #000 4px, transparent 4px);
            
            
            background-size: 8px 8px; 
            
            
            pointer-events: none;
        }

    </style>
</head>
<body>

    <div class="matrix-container">
        <h1 class="dot-matrix-text" id="teksHalaman">Engkau
Bunga Jiwaku</h1>
    </div>

    <script>
        const daftarTeks = [
            { teks: "Bulan pun\nberganti", jedaDetik: 4 },
            { teks: "Harumnya\ntelah pergi", jedaDetik: 3.5 },
            { teks: "Aku\nmenanti", jedaDetik: 3.5 },
            { teks: "Aku\ntak mengerti", jedaDetik: 3.5 },
            { teks: "Biar pun kita hilang,\ntak lagi bersama", jedaDetik: 8.5 },
            { teks: "Tak lagi\nbercinta berdua", jedaDetik: 4 },
            { teks: "Masih saja kupandang\nwajahnya yang hilang", jedaDetik: 9 },
            { teks: "Tak akan berganti,\ndia abadi", jedaDetik: 10.5 },
            { teks: "Abadi untuk selamanya,\nselama-lamanya", jedaDetik: 10 },
        ];

        let indeksTeks = 0;
        const teksHalaman = document.getElementById("teksHalaman");

        function tampilkanTeks() {
            const bagianSekarang = daftarTeks[indeksTeks];
            teksHalaman.textContent = bagianSekarang.teks;

            setTimeout(function () {
                indeksTeks = (indeksTeks + 1) % daftarTeks.length;
                tampilkanTeks();
            }, bagianSekarang.jedaDetik * 1000);
        }

        tampilkanTeks();
    </script>
</body>
</html>
